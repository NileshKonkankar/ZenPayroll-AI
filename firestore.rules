rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function getAdmin(uid) {
      return get(/databases/$(database)/documents/admins/$(uid));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isStaff() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'KonkankarNilesh@gmail.com'
      );
    }

    function isAdmin() {
      return isStaff() && (
        request.auth.token.email == 'KonkankarNilesh@gmail.com' ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'ADMIN')
      );
    }

    function isHR() {
      return isStaff() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'HR';
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidEmployee(data) {
      return data.keys().hasAll(['name', 'email', 'role', 'salaryStructure', 'status'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.email is string && data.email.size() <= 200
        && data.role is string
        && data.status is string && data.status in ['active', 'inactive', 'on_leave']
        && data.salaryStructure is map
        && data.salaryStructure.basic is number && data.salaryStructure.basic >= 0
        && data.salaryStructure.hra is number && data.salaryStructure.hra >= 0
        && data.salaryStructure.allowances is number && data.salaryStructure.allowances >= 0;
    }

    function isValidPayrollRecord(data) {
      return data.keys().hasAll(['employeeId', 'month', 'netSalary', 'processedAt'])
        && data.employeeId is string
        && data.month is string && data.month.size() <= 20
        && data.netSalary is number && data.netSalary >= 0
        && data.processedAt is string; // Simplified for demo, usually timestamp
    }

    // --- Collections ---

    match /employees/{employeeId} {
      allow get: if isSignedIn() && (isOwner(employeeId) || isStaff());
      allow list: if isSignedIn() && (isStaff()); 
      
      allow create: if isStaff() && isValidEmployee(incoming()) && isValidId(employeeId);
      
      allow update: if isStaff() 
        && isValidEmployee(incoming())
        && incoming().email == existing().email // Immutable email
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'role', 'salaryStructure', 'status', 'department', 'updatedAt'])
        );
      
      allow delete: if isStaff();
    }

    match /payrollRecords/{recordId} {
      allow get: if isSignedIn() && (isOwner(existing().employeeId) || isStaff());
      allow list: if isSignedIn() && (isStaff() || (resource.data.employeeId == request.auth.uid));
      
      allow create: if isStaff() && isValidPayrollRecord(incoming()) && isValidId(recordId);
      allow update: if false; // Payroll history is immutable
      allow delete: if isStaff();
    }

    match /admins/{adminId} {
      allow read: if isStaff();
      allow create: if isAdmin() || (isSignedIn() && !exists(/databases/$(database)/documents/admins/FIRST_ADMIN_ID)); // Bootstrap logic placeholder
      allow update, delete: if isAdmin();
    }

    match /test/{docId} {
      allow read: if isSignedIn();
    }
  }
}
